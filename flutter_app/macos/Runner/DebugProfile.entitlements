<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outbound networking. Flutter's macOS template enables the sandbox but
	     does NOT grant this, so every network call fails with
	     "Operation not permitted (errno 1)" until it is added. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- flutter_secure_storage writes the session token to the Keychain. The
	     sandbox grants an app its own keychain access by default; an explicit
	     keychain-access-group is only for sharing between apps and resolves to
	     an empty array without a signing team, so it is deliberately omitted. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- The attach button opens NSOpenPanel. Under the sandbox a picked file is
	     only readable if this entitlement is present; without it openFile()
	     returns a path whose bytes cannot be read. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Dictation records from the microphone. Under the sandbox the speech
	     recogniser returns no result at all without this, silently. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
